{
  "name": "monomane-sugoroku",
  "version": "5.0.0",
  "description": "街のモノまねすごろく（Cloudflare Pages Functions + D1 版）",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "wrangler pages dev . --d1 DB=monomane-sugoroku",
    "db:migrate:local": "wrangler d1 execute monomane-sugoroku --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute monomane-sugoroku --remote --file=./migrations/0001_init.sql",
    "deploy": "wrangler pages deploy ."
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
